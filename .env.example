JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_TOKEN=your_api_token_here
TEAM_EMAILS=teammate1@company.com,teammate2@company.com,teammate3@company.com
REFRESH_INTERVAL=5m
JIRA_PROJECT=APP,SOS
JIRA_TEAM_FROM=2001-01-01

# Optional override; normally derived from the issuer:
# the OIDC flow verifies tokens via the issuer):

# --- Firebase (web config — from Firebase console → Project settings → Your apps → Web app) ---
# Not secrets; safe in the client. Security comes from Firebase Auth + Security Rules.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Jira custom field id holding the "Release" on a story card (default customfield_10127):
#JIRA_RELEASE_FIELD=customfield_10127
# Jira custom field id holding story points (default customfield_10016):
#JIRA_POINT_FIELD=customfield_10016

# Subtask Gen (beta): suggest subtasks from Confluence specs mentioned on a story
CONFLUENCE_SPEC_SPACE=Merchant
SUBTASK_PREFIX_BE=[BE][MP]
SUBTASK_PREFIX_FE=[MM][FE]
SUBTASK_PREFIX_QA=[QA]

# Integration Plan: roles that get a target-date column
INTEGRATION_ROLES=BE,WEB,MOB
