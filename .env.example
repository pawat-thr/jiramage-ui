# ============================================================================
# jiramage .env — copy to `.env` and fill in. Restart `npm run dev` after edits.
#
# ACCESS MATRIX (how the app reaches Jira):
#   · minimum app (no Firebase):  JIRA_TOKEN required — one shared API token,
#     all writes act as that account
#   · team mode + Atlassian SSO:  NO token needed — users sign in with Jira
#     and act as THEMSELVES (per-user permissions). See docs/PLAN-ORG-SSO.md.
#
# Fields marked [team-config] can be overridden at runtime in
# Settings → Team configuration (Firebase > .env > built-in default).
# ============================================================================

# --- Jira connection (required) ---------------------------------------------
# Your Jira Cloud site. All API calls go through the dev-server proxy — the
# token below never reaches the browser.
JIRA_URL=https://yourcompany.atlassian.net
# EMAIL + TOKEN are a PAIR (Jira Basic auth) — needed for the minimum app
# (no Firebase) and for dev/e2e fallbacks. An SSO deployment leaves BOTH
# empty: identity comes from whoever logs in, never from this file.
JIRA_EMAIL=you@company.com
JIRA_TOKEN=your_api_token_here
# [team-config] Project keys the app queries (JQL scope for every page).
JIRA_PROJECT=APP,SOS
# [team-config] Only issues created since this date are fetched/counted.
JIRA_TEAM_FROM=2024-05-01

# --- Team roster -------------------------------------------------------------
# The whole dev team, INCLUDE YOURSELF (deduped against JIRA_EMAIL).
# Drives: Team Task, dashboards, Capacity Planner, pickers, @mentions,
# and the team-mode login allowlist (password mode).
TEAM_EMAILS=me@company.com,teammate1@company.com,teammate2@company.com

# --- App behavior ------------------------------------------------------------
# [team-config] Auto-refresh interval for issue data (30s / 5m / 1h style).
REFRESH_INTERVAL=5m
# [team-config] Burn-tracking working windows — lunch break = simply not a
# window. 1 point = 1 hour; a full set of windows = 1 manday (= 8 pt).
WORK_TIME=09:30-12:00,13:00-18:30
# [team-config] Working days (burn + Capacity Planner day-off capacity).
WORK_DAYS=Mon,Tue,Wed,Thu,Fri

# --- Jira custom fields (defaults fit this org — override if yours differ) ---
# Field holding the "Release" option on a story (Delivery Tracking, filters):
#JIRA_RELEASE_FIELD=customfield_10127
# Field holding story points (burn, planner, delivery rollups):
#JIRA_POINT_FIELD=customfield_10016

# --- Spec Wizard (beta) -------------------------------------------------------
# [team-config] Only Confluence pages from this space become spec suggestions
# (empty = all spaces). Also powers the Spec chips on task tables.
CONFLUENCE_SPEC_SPACE=Merchant
# [team-config] Per-role name prefixes for generated subtasks; the Delivery
# page's Prefix filter offers exactly these values.
SUBTASK_PREFIX_BE=[BE][MP]
SUBTASK_PREFIX_FE=[MM][FE]
SUBTASK_PREFIX_QA=[QA]

# --- Burn statuses -------------------------------------------------------------
# [team-config] Statuses counted as "in development" (live burn meter):
BURN_STATUSES=In Dev,In Dev Testing
# [team-config] Post-dev statuses where the frozen "used X/Y pt" stat shows:
BURN_FINISHED_STATUSES=PR Review,Waiting for deployment,Done

# --- Integration Plan (team mode) ----------------------------------------------
# [team-config] Roles that get a target-date column in the planning grid.
INTEGRATION_ROLES=BE,WEB,MOB

# --- Teamage (team mode): teams + their leads — parallel lists -----------------
# TEAMS[i] is led by TEAM_LEADS[i]. Leads see the Teamage page and manage
# members there (stored in Firestore). A signed-in user with NO team lands on
# a "no team yet" page until a lead adds them. Empty = feature off (env roster).
TEAMS=mp,aoa
TEAM_LEADS=lead.mp@company.com,lead.aoa@company.com

# --- Firebase web config (team mode; omit entirely for the minimum app) --------
# Firebase console → Project settings → Your apps → Web app. NOT secrets —
# security comes from Firebase Auth + the published firestore.rules.
# Enables: login, Team Board, PR Review, Inbox, Integration Plan, shared
# settings/team-config, Capacity Planner persistence, profile pictures.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- Atlassian SSO (optional, team mode — docs/PLAN-ORG-SSO.md Phase 0) --------
# OAuth 2.0 app from developer.atlassian.com (callback:
# http://localhost:5173/auth/callback). With SSO on: the login page becomes a
# single "Continue with Atlassian" button, NO passwords, writes act as the
# signed-in user, and JIRA_TOKEN can be left empty.
# Whitelist = Firebase Auth users (Console → Authentication → Users):
# user exists → invited; delete the user → access revoked.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Service-account key for the whitelist lookup + silent Firebase sign-in
# (Firebase console → Project settings → Service accounts → Generate key).
# Keep the file OUT of git — serviceAccount.json is already gitignored.
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
# Only needed if your dev server runs on a non-default URL:
#ATLASSIAN_CALLBACK_URL=http://localhost:5173/auth/callback
