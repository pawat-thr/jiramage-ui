rules_version = '2';

// Firestore Security Rules. Identity = Firebase Auth. Publish in the Firebase
// console: Build → Firestore Database → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function email() {
      return request.auth.token.email;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Per-user preferences (e.g. default Story List Release). Owner only.
    match /userPrefs/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Team Board labels: any member can create, rename (name only), or delete.
    // (The app only allows deleting labels with zero tasks.)
    match /labels/{labelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorEmail == email();
      allow update: if signedIn() && changed().hasOnly(['name']);
      allow delete: if signedIn();
    }

    // Team Board tasks: owner edits/deletes; anyone signed in may change status.
    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorEmail == email();
      allow update: if signedIn() && (
        ( resource.data.authorEmail == email()
          && request.resource.data.authorEmail == resource.data.authorEmail )
        ||
        changed().hasOnly(['status', 'updatedAt'])
        ||
        // label renames cascade to every task, regardless of owner
        changed().hasOnly(['label', 'updatedAt'])
      );
      allow delete: if signedIn() && resource.data.authorEmail == email();
    }

    // PR review board.
    match /prs/{prId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.authorEmail == email();

      allow update: if signedIn() && (
        ( resource.data.authorEmail == email()
          && request.resource.data.authorEmail == resource.data.authorEmail )
        ||
        ( email() in resource.data.reviewers
          && changed().hasOnly(['status', 'updatedAt']) )
      );

      allow delete: if signedIn() && resource.data.authorEmail == email();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorEmail == email();
        allow update, delete: if false;
      }
    }

    // In-app notification inbox (e.g. "assigned you to review a PR").
    // Sender creates entries addressed to teammates; only the recipient can
    // read them, flip the read flag, or delete them.
    match /notifications/{notifId} {
      allow read: if signedIn() && resource.data.toEmail == email();
      allow create: if signedIn()
        && request.resource.data.fromEmail == email()
        && request.resource.data.toEmail != email()
        && request.resource.data.read == false;
      allow update: if signedIn()
        && resource.data.toEmail == email()
        && changed().hasOnly(['read'])
        && request.resource.data.read == true;
      allow delete: if signedIn() && resource.data.toEmail == email();
    }

    // Team-wide app settings (e.g. the dev prompt template): every member can
    // read them and update them — one shared configuration for the whole team.
    match /settings/{docId} {
      allow read, write: if signedIn();
    }

    // Team-config audit log: APPEND-ONLY — entries can be read and created,
    // never edited or deleted, so the "who changed what" history can't be
    // rewritten. Each entry must be stamped with the writer's own email.
    match /settings/config/history/{entryId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == email();
    }

    // Teamage (draft of PLAN-ORG-SSO Phase B): team member docs. Lead-only
    // editing is enforced client-side for now (leads come from env, which
    // rules can't read) — same trust level as the rest of the app; hardens
    // in Phase C when teams/leads move fully into Firestore.
    match /teams/{team}/members/{member} {
      allow read, write: if signedIn();
    }

    // Profile pictures: one small doc per member (photo data-URL). Everyone
    // reads; each member can only write/delete their OWN (doc id = email).
    match /profiles/{member} {
      allow read: if signedIn();
      allow write: if signedIn() && member == email();
    }

    // Integration Plan rows (per release+story): any member can read, sync
    // (create/delete during sync), and edit env/dates/remark.
    match /integration/{docId} {
      allow read, write: if signedIn();
    }

    // QA Capacity Planner: one doc per QA user per month; any member can
    // read and update the plan.
    match /qaPlan/{docId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
